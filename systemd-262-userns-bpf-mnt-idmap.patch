+/* vfsmount.mnt_idmap arrived in Linux 6.3. Builder vmlinux.h can be older, so do not
+ * touch that member on struct vfsmount from vmlinux.h. A CO-RE flavor relocates
+ * against the kernel the program is loaded into; a missing field means the mount
+ * is not idmapped. */
+struct mnt_idmap___local {
+        struct uid_gid_map uid_map;
+        struct uid_gid_map gid_map;
+} __attribute__((preserve_access_index));
+
+struct vfsmount___idmap {
+        struct mnt_idmap___local *mnt_idmap;
+} __attribute__((preserve_access_index));
+
+static struct mnt_idmap___local *vfs_mount_idmap(struct vfsmount *mnt) {
+        if (!bpf_core_field_exists(struct vfsmount___idmap, mnt_idmap))
+                return NULL;
+        return BPF_CORE_READ((struct vfsmount___idmap *) mnt, mnt_idmap);
+}
